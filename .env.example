# Browser (public) values — from Supabase: Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only values — set in Vercel > Project > Settings > Environment Variables. Never expose these.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key
SITE_URL=https://your-app.vercel.app
ANTHROPIC_API_KEY=your-claude-api-key
# Optional: ANTHROPIC_MODEL=claude-sonnet-5-5
# Random string (at least 16 characters). Vercel sends it to /api/keepalive so only the cron can call it.
CRON_SECRET=make-a-long-random-string
